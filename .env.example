# ==============================================================================
# BrandFlow ERP - متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم
# ==============================================================================

# منفذ السيرفر (Cloud Run يمرره تلقائياً كـ 8080)
PORT=3000

# GEMINI_API_KEY: اختياري - لتشغيل محلل الأوردرات الذكي على السيرفر.
# بدونه يعمل المحلل المحلي المدمج تلقائياً.
GEMINI_API_KEY=""

# ==============================================================================
# Supabase (إلزامي للإنتاج - المصادقة وقاعدة البيانات)
# من لوحة تحكم المشروع: Project Settings -> API
# ==============================================================================

# قيم عامة للواجهة (anon key مصمم ليكون عاماً وتحميه سياسات RLS).
# اختيارية الآن: إن تُركت فارغة تجلب الواجهة الإعدادات من السيرفر عبر /api/public-config.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# نفس القيم للسيرفر (التحقق من الجلسات)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# مفتاح سري للسيرفر فقط - لإنشاء/تعديل/حذف حسابات المستخدمين من شاشة الفريق.
# لا تضعه أبداً في متغيرات VITE_ ولا في المتصفح.
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# وضع التطوير المحلي فقط (لا تستخدمه في الإنتاج أبداً)
# ==============================================================================
# يسمح بالدخول بدون Supabase وتخزين db.json محلي
ALLOW_DEV_AUTH=false
